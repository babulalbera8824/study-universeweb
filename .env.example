# Firebase Config - Firebase Console se copy karo
VITE_FIREBASE_API_KEY=AIzaSyXXXX-Your-Api-Key
VITE_FIREBASE_AUTH_DOMAIN=study-universe-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=study-universe-xxxxx
